# URL интерфейса и API. Для локального UI API обычно доступен через Vite proxy.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5173/api

# auto: определить Keycloak автоматически; required: вход обязателен; disabled: SSO выключен.
E2E_AUTH_MODE=auto
E2E_USERNAME=
E2E_PASSWORD=
E2E_API_TOKEN=

# Отдельные пользователи для AUTH-03. Если не заданы, role-тесты будут SKIPPED.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_EDGE_USERNAME=
E2E_EDGE_PASSWORD=
E2E_NO_ROLE_USERNAME=
E2E_NO_ROLE_PASSWORD=

# Основная буровая с current/history данными. Если не задана, берётся первая карточка.
E2E_EDGE_ID=
# Буровая, к которой E2E_EDGE_USERNAME гарантированно не имеет доступа.
E2E_FORBIDDEN_EDGE_ID=
# Отдельные тестовые данные для видео-сценариев.
E2E_VIDEO_EDGE_ID=
E2E_NO_VIDEO_EDGE_ID=

# Стабильные фрагменты имени или технического тега.
E2E_INDICATOR_QUERY=
E2E_HISTORY_TAG_QUERY=
# Тег, значение которого гарантированно меняется во время проверки.
E2E_LIVE_TAG=

# Строгие проверки данных включайте только на подготовленном стенде.
E2E_REQUIRE_HISTORY_DATA=false
E2E_REQUIRE_VIDEO_PLAYBACK=false
E2E_LIVE_WAIT_SECONDS=30
E2E_SSE_OBSERVE_SECONDS=8
E2E_MAX_CURRENT_REQUESTS=12

# Visual tests выключены, пока команда не утвердит screenshot baselines.
E2E_VISUAL_ENABLED=true
# Включайте только при осознанном обновлении утверждённых эталонных снимков.
E2E_UPDATE_SNAPSHOTS=false

# Seed работает только с edge ID, начинающимися на e2e-.
E2E_DATABASE_URL=
E2E_INGEST_API_KEY=
E2E_VIDEO_WS_URL=

# Необязательные версии, которые попадут в отчёт.
E2E_UI_COMMIT=
E2E_CLOUD_COMMIT=

# Настройки запуска.
E2E_BROWSER=chromium
E2E_HEADLESS=true
E2E_SLOW_MO_MS=0
E2E_TIMEOUT_MS=20000
E2E_VIEWPORT_WIDTH=1440
E2E_VIEWPORT_HEIGHT=1000
